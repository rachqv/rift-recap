# Copy this file to .env.local and fill it in. .env.local is git-ignored: never commit a real key.

# Required for real players. Get a key at https://developer.riotgames.com
# (a development key expires every 24 hours, so regenerate it when the app starts returning 403).
RIOT_API_KEY=

# Optional. The public address of the site, used for link-preview images (Open Graph).
# Defaults to http://localhost:3000, or to your Vercel production URL when deployed there.
# SITE_URL=https://your-domain.example
